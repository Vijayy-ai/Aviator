rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Game images (new uploads + migrated from Uploadcare)
    match /games/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fallback: any other path — logged-in users only (safe default)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
